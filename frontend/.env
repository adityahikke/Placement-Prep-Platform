# ------------------------------------------------------------------
# Frontend environment variables (Vite)
# Copy this file to ".env" and fill in the values you need.
# Only variables prefixed with VITE_ are exposed to the app.
# ------------------------------------------------------------------

# Google OAuth 2.0 "Web application" Client ID, from the Google Cloud Console
# (APIs & Services -> Credentials). Required to enable the "Continue with Google"
# button. Leave empty and the button shows an inactive, self-explaining state.
# Example: 1234567890-abcdefg.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=821144344369-52qf8tvtmf44l8ejmkdstoktco2bcqe8.apps.googleusercontent.com

# Base URL of the backend API.
VITE_API_BASE_URL=http://localhost:8080
